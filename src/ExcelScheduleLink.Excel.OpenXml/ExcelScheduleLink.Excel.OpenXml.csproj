<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ExcelScheduleLink.Excel.OpenXml</RootNamespace>
    <AssemblyName>ExcelScheduleLink.Excel.OpenXml</AssemblyName>
    <!--
      The Open XML SDK dependency is confined to this project.
      The Revit2024 project must not reference this project statically (it
      references Contracts only). If the ReaderHost approach is adopted, the
      OpenXml dependency can be removed from the Revit process entirely.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets unit tests exercise internal types (RawCellReader / CellDisplayFormatter) directly -->
    <InternalsVisibleTo Include="ExcelScheduleLink.Excel.OpenXml.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExcelScheduleLink.Contracts\ExcelScheduleLink.Contracts.csproj" />
  </ItemGroup>

</Project>
